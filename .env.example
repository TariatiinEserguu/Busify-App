# =============================================================================
# BUSIFY configuration
# Copy this file to `.env` (npm run setup does it for you) and adjust values.
# `.env` is git-ignored. Never commit real passwords or secrets.
# =============================================================================

# ---- Backend server ---------------------------------------------------------

# development | production | test
NODE_ENV=development

# Network interface the server listens on.
#   127.0.0.1  -> only this computer can connect (default, safest)
#   0.0.0.0    -> every network interface, so phones on your Wi-Fi can connect
#   192.168.x.x -> one specific LAN interface (see `npm run lan-info`)
# `npm run lan` temporarily uses 0.0.0.0 without editing this file.
HOST=127.0.0.1
PORT=4000

# Reject requests that do not come from loopback or private LAN addresses
# (10.x, 172.16-31.x, 192.168.x, link-local). Keep this true unless you know
# exactly why you need public access.
LAN_ONLY=true

# SQLite database file. A relative path is resolved from server/prisma/,
# so the default database lives at server/data/busify.db.
DATABASE_URL="file:../data/busify.db"

# How long a sign-in lasts before the user must log in again.
SESSION_TTL_HOURS=168

# Secure flag on the session cookie: auto | true | false
# auto = secure only when HTTPS_ENABLED=true.
COOKIE_SECURE=auto

# bcrypt work factor for password hashing (10-14 is sensible).
BCRYPT_ROUNDS=12

# Sign-in / registration attempts allowed per IP address per 15 minutes.
AUTH_RATE_LIMIT=30

# Optional HTTPS for LAN testing. Browsers only allow GPS, notifications and
# screen wake lock on https:// pages or on http://localhost.
# When enabled without cert files, a self-signed certificate is generated into
# server/certs/ (your phone will show a one-time security warning).
HTTPS_ENABLED=false
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=

# Extra browser origins allowed to call the API, comma separated.
# Not needed when the frontend is served by this server or by the Vite proxy.
CORS_ORIGINS=

# debug | info | warn | error
LOG_LEVEL=info

# ---- Demonstration data -----------------------------------------------------

# Allow the demo accounts created by `npm run db:seed:demo` to sign in.
# Set to false for anything other than a classroom demo: demo accounts are then
# refused at login and the demo seed command will not run.
DEMO_MODE=true

# Password given to the demo accounts (admin, support agent, passenger) by
# `npm run db:seed:demo`. Demo only — change it if your demo is shared.
# (Avoid the # character in unquoted values: it starts a comment.)
DEMO_ACCOUNT_PASSWORD=BusifyDemo2026

# ---- Frontend (Vite) --------------------------------------------------------
# Only variables starting with VITE_ are exposed to the browser. Do not put
# secrets in them.

# Base URL of the backend API. Keep the relative value "/api" so the browser
# calls the same computer that served the page. This is what makes phones on
# your Wi-Fi work: on a phone, "localhost" means the phone itself, not your PC.
# Only set an absolute URL (e.g. http://192.168.1.20:4000/api) if you host the
# frontend separately — and then add that origin to CORS_ORIGINS.
VITE_API_BASE_URL=/api

# Map tiles. OpenStreetMap tiles need internet access. Point this at a local
# tile server if you need fully offline maps (the rest of BUSIFY stays local).
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Map centre used before a location or route is known (lat,lng) and zoom.
VITE_MAP_DEFAULT_CENTER=47.9185,106.9177
VITE_MAP_DEFAULT_ZOOM=13

# Vite development server (npm run dev). Use 0.0.0.0 to open the dev server
# from other devices; API calls are proxied to the backend above.
CLIENT_DEV_HOST=127.0.0.1
CLIENT_DEV_PORT=5173
